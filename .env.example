POSTGRES_PASSWORD=replace-with-a-long-random-password
OWNER_API_TOKEN=replace-with-at-least-32-random-characters
GEMINI_API_KEY=
GENERATION_MODEL=
EMBEDDING_MODEL=
SEMANTIC_MIN_SIMILARITY=0.6

# Optional providers; keep keys on the server, never in browser code.
OPENAI_API_KEY=
SARVAM_API_KEY=
# Comma-separated additional adapter-compatible Gemini model IDs.
GEMINI_MODELS=
APP_ENV=development
# Task defaults are configured in Settings after login. GENERATION_MODEL
# remains the initial Gemini default for all tasks.

# Enable only after migration 0007; set the same flag on API and worker.
MEMORIES_ENABLED=false
# Optional initial model defaults (also editable in Settings → Memory organisation).
RECONCILIATION_PROVIDER=gemini
RECONCILIATION_MODEL=

# Phase 2: DATABASE_URL is the restricted runtime role.
# Set MIGRATION_DATABASE_URL only on the web/migration process, never in browser config.
# Leave unset until a separate runtime database role has been provisioned.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration-owner:password@host/database
# Disable the legacy token for multi-user operation; if explicitly enabled it is
# restricted to the original workspace only.
ALLOW_OWNER_API_TOKEN=false
